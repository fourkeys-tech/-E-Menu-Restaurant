// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MODELS ====================

model Restaurant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  address        String?
  phone          String?
  email          String?
  logoUrl        String?
  coverImageUrl  String?
  description    String?
  openHours      String?
  taxPercentage  Float    @default(10)
  serviceCharge  Float    @default(0)
  primaryColor   String   @default("#1A1A1A")
  accentColor    String   @default("#D9A441")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  tables      Table[]
  categories  Category[]
  menuItems   MenuItem[]
  orders      Order[]
  promotions  Promotion[]
  activityLogs ActivityLog[]
  expenses    Expense[]
  expenseCategories ExpenseCategory[]
  shifts      Shift[]
  customers   Customer[]
  inventoryItems InventoryItem[]
  reservations Reservation[]
  notifications Notification[]

  @@map("restaurants")
}

model User {
  id           String   @id @default(uuid())
  restaurantId String?
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("kasir")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant       Restaurant? @relation(fields: [restaurantId], references: [id])
  confirmedPayments Payment[]
  ordersAsCashier  Order[] @relation("OrderCashier")
  ordersAsChef     Order[] @relation("OrderChef")
  activityLogs     ActivityLog[]
  expenses         Expense[]
  shifts           Shift[]
  inventoryTransactions InventoryTransaction[]

  @@map("users")
}

model Table {
  id           String  @id @default(uuid())
  restaurantId String
  tableNumber  String
  label        String?
  capacity     Int     @default(4)
  qrCodeUrl    String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]
  reservations Reservation[]

  @@unique([restaurantId, tableNumber])
  @@map("tables")
}

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  slug         String
  imageUrl     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]

  @@unique([restaurantId, slug])
  @@map("categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  slug         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  isBestSeller Boolean  @default(false)
  isSpicy      Boolean  @default(false)
  stock        Int?
  allergenInfo String?
  variants     String?    // JSON string: Array of {name, options: [{label, additionalPrice}]}
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@unique([restaurantId, slug])
  @@map("menu_items")
}

model Order {
  id            String        @id @default(uuid())
  restaurantId  String
  tableId       String?
  orderNumber   String        @unique
  customerName  String?
  promotionId   String?
  status        String        @default("pending")
  paymentStatus String        @default("unpaid")
  paymentMethod String?
  notes         String?
  subtotal      Float
  discountAmount Float        @default(0)
  taxAmount     Float         @default(0)
  serviceCharge Float         @default(0)
  total         Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cashierId     String?
  chefId        String?
  customerId    String?

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  table         Table?        @relation(fields: [tableId], references: [id])
  promotion     Promotion?    @relation(fields: [promotionId], references: [id])
  cashier       User?         @relation("OrderCashier", fields: [cashierId], references: [id])
  chef          User?         @relation("OrderChef", fields: [chefId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  orderItems    OrderItem[]
  payment       Payment?

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  menuItemId     String
  quantity       Int
  notes          String?
  priceAtOrder   Float
  variantSelected String?  // JSON string: {name, selectedOption: {label, additionalPrice}}
  subtotal       Float
  createdAt      DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Payment {
  id                    String                @id @default(uuid())
  orderId               String                @unique
  method                String
  status                String                @default("pending")
  amount                Float
  gatewayTransactionId  String?
  midtransPaymentType   String?
  snapToken             String?
  snapRedirectUrl       String?
  confirmedByUserId     String?
  paidAt                DateTime?
  expiredAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  order       Order  @relation(fields: [orderId], references: [id])
  confirmedBy User?  @relation(fields: [confirmedByUserId], references: [id])

  @@map("payments")
}

model Promotion {
  id            String       @id @default(uuid())
  restaurantId  String
  name          String
  description   String?
  discountType  String
  discountValue Float
  minOrderAmount Float?
  maxDiscount   Float?
  maxUsage      Int?
  code          String?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, code])
  @@map("promotions")
}

model ActivityLog {
  id           String   @id @default(uuid())
  restaurantId String
  userId       String?
  action       String
  details      String?
  createdAt    DateTime @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("activity_logs")
}

model Expense {
  id           String   @id @default(uuid())
  restaurantId String
  userId       String
  amount       Float
  category     String
  description  String?
  receiptUrl   String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model ExpenseCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("expense_categories")
}

model Shift {
  id            String    @id @default(uuid())
  restaurantId  String
  userId        String
  openTime      DateTime  @default(now())
  closeTime     DateTime?
  openingCash   Float     @default(0)
  closingCash   Float?
  expectedCash  Float?
  diff          Float?
  status        String    @default("open") // open, closed
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

model Customer {
  id               String   @id @default(uuid())
  restaurantId     String
  name             String
  phone            String?
  email            String?
  totalVisits      Int      @default(0)
  totalSpent       Float    @default(0)
  lastVisitAt      DateTime?
  favoriteMenuId   String?  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([restaurantId, phone])
  @@map("customers")
}

model InventoryItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  unit         String   // e.g., Kg, Ltr, Pcs
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([restaurantId, name])
  @@map("inventory_items")
}

model InventoryTransaction {
  id           String   @id @default(uuid())
  itemId       String
  type         String   // 'IN' | 'OUT'
  quantity     Float
  note         String?
  userId       String   
  createdAt    DateTime @default(now())

  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@map("inventory_transactions")
}

model Reservation {
  id              String   @id @default(uuid())
  restaurantId    String
  tableId         String?
  customerName    String
  phone           String?
  reservationDate DateTime
  guestCount      Int      @default(1)
  status          String   @default("pending") // pending, confirmed, cancelled, completed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  table           Table?     @relation(fields: [tableId], references: [id])

  @@map("reservations")
}


model Notification {
  id             String   @id @default(uuid())
  restaurantId   String
  title          String
  message        String
  type           String   // 'ORDER' | 'STOCK' | 'SYSTEM'
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("notifications")
}
