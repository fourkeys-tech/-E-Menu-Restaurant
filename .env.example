# ==========================================
# SmartMenu - Environment Variables
# ==========================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartmenu_db"

# --- JWT Auth ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_CUSTOMER_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3002

# --- Midtrans (Sandbox) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Cloudinary (optional) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Next.js - Customer App (.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ==========================================
# Next.js - Admin App (.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3002
